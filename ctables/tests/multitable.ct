#
# $Id$
#

package require ctable

namespace eval ::ctable_test {
	if {![info exists suffix]} {
		set suffix ""
	}
	if {![info exists nametags]} {
		set nametags [list]
	}
}

CExtension multi$::ctable_test::suffix 1.0 {

CTable nameval$::ctable_test::suffix {
    varstring name {*}$::ctable_test::nametags
    varstring value
}

CTable elements$::ctable_test::suffix {
    varstring name {*}$::ctable_test::nametags
    varstring symbol
}

CTable anim_characters$::ctable_test::suffix {
    varstring id indexed 1 unique 1 notnull 1
    varstring name indexed 1 unique 1
    varstring home indexed 1 unique 0
    varstring show indexed 1 unique 0
    varstring dad
    boolean alive default 1
    varstring gender default male
    int age indexed 1 unique 0
    int coolness
}

}

CExtension multitoo 1.0 {

CTable albums {
    varstring album
    varstring artist
    varstring year
    varstring genre
}

}

package require Multi$::ctable_test::suffix
package require Multitoo

